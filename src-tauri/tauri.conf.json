{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "APIKit",
  "version": "0.5.6",
  "identifier": "com.sandeep.apikit",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "APIKit",
        "url": "splash.html",
        "width": 600,
        "height": 360,
        "resizable": false,
        "center": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "main",
        "title": "APIKit",
        "width": 1200,
        "height": 780,
        "minWidth": 720,
        "minHeight": 500,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBQUE2MjA3QjE5RkY2NzMKUldSejlwK3hCMktxK2lYQ09jYllUVGRJZ3dSTTA1TU5kZitGSVd0YzNIUlQvV1RWcndIU0lpQ2sK",
      "endpoints": [
        "https://github.com/saileshkush95/APIKit/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
